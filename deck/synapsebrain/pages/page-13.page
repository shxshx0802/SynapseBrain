pageType: content
background:
  type: solid
  color: "#0D1117"
elements:
  - elementId: bg
    elementType: image
    bounds: [0, 0, 960, 540]
    src: media/cover-bg.jpg
    fit:
      mode: fill
  - elementId: bg-mask
    elementType: shape
    bounds: [0, 0, 960, 540]
    shapeName: roundRect
    adjustments: [0]
    fill:
      type: gradient
      gradientType: linear
      stops:
        - position: 0
          color: "#0D1117E6"
        - position: 0.5
          color: "#0D1117B3"
        - position: 1
          color: "#0D1117E6"
      angle: 90
  - elementId: title
    elementType: text
    bounds: [130, 200, 700, 110]
    content:
      text: |-
        <p style="text-align: center; line-height: 1.4; margin-left: 0px;">让每一次讨论，都变成触手可及的共识</p>
      color: "#F2F7F7"
      fontSize: 32
      bold: true
      fontFamily: Noto Sans SC, Noto Sans SC
      lineHeight: 1.4
      wrap: true
      align: [center, middle]
  - elementId: line
    elementType: shape
    bounds: [411, 336, 138, 1]
    shapeName: straightConnector1
    border: {style: solid, width: 2, color: "#5EEAD4"}
  - elementId: sub
    elementType: text
    bounds: [180, 358, 600, 34]
    content:
      text: |-
        <p style="text-align: center; line-height: 1.25; margin-left: 0px;">SynapseBrain · 多 AI 协同讨论画布</p>
      color: "#5EEAD4"
      fontSize: 17
      bold: true
      fontFamily: Noto Sans SC, Noto Sans SC
      lineHeight: 1.25
      wrap: true
      align: [center, middle]
  - elementId: foot
    elementType: text
    bounds: [180, 470, 600, 28]
    content:
      text: |-
        <p style="text-align: center; line-height: 1.25; margin-left: 0px;">感谢聆听 · 欢迎交流</p>
      wrap: true
      align: [center, middle]
      style: $text8

# ============================================================
# KeySphere 环境变量样例
# 使用方式：复制本文件为 .env，填入真实值；.env 永不提交 Git
# 复制命令：cp .env.example .env
# ============================================================

# ---------- 服务 ----------
# 开发服务器端口
VITE_DEV_PORT=7100
# WebSocket 服务端口（实时消息推送）
WS_PORT=7101

# ---------- AI Provider（按需填写，不用的留空） ----------
# 浏览器端变量必须带 VITE_ 前缀；填入后前端自动从演示模式切换为 Kimi 实时模式
VITE_MOONSHOT_API_KEY=
VITE_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
VITE_MOONSHOT_MODEL=kimi-k2.6

# OpenAI 兼容接口（OpenAI / DeepSeek / 其他兼容端点均可，后续版本支持）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Moonshot Kimi
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2-0711-preview

# 自定义 Provider（可选，JSON 格式：名称 -> base_url/api_key/model）
# 例：CUSTOM_PROVIDERS='{"qwen":{"baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKey":"sk-xxx","model":"qwen-plus"}}'
CUSTOM_PROVIDERS=

# ---------- 额度管家（默认值，运行时可改） ----------
# 每个 AI 角色的单房间 token 预算（节俭档 / 标准档 / 深入档）
QUOTA_BUDGET_FRUGAL=20000
QUOTA_BUDGET_STANDARD=80000
QUOTA_BUDGET_DEEP=200000
# 额度低于该比例时自动降档（0~1）
QUOTA_DOWNSHIFT_THRESHOLD=0.2

# ---------- 存储 ----------
# SQLite 数据库文件路径（留空 = 项目目录下 data/keysphere.db）
DATABASE_PATH=
# 上传文件存储目录（留空 = 项目目录下 data/uploads）
UPLOAD_DIR=

# ---------- 手势与动效 ----------
# 摄像头手势（可选实验功能）：on / off
CAMERA_GESTURES=off
# 默认关闭震动反馈：true / false（无障碍考虑）
REDUCE_MOTION_DEFAULT=false
